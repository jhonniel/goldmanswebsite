# On Vercel, set this to the live domain. If empty, the Vercel URL is used.
VITE_SITE_URL=https://www.example.com
# Optional override. Defaults to /api/contact on Vercel.
# VITE_CONTACT_API_URL=/api/contact
# Server-only. Required for the contact form and thank-you email.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@goldmanssupply.com
# CONTACT_FROM_EMAIL=Goldman's Supply Corporation <info@goldmanssupply.com>
# Google Search Console verification code
# VITE_GOOGLE_SITE_VERIFICATION=
# Optional Google Analytics. Loads only after cookie consent.
# VITE_GA_MEASUREMENT_ID=
